CHAIN_ID=97
BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
PUBLIC_URL=http://localhost:3001
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Set these only after deployment; blank means unavailable, never a fake identity.
FACTORY_ADDRESS=
KEEPER_ADDRESS=
AGENT_ID=
LISTING_ID=
EXECUTION_ENABLED=false
# Mount a separate keeper secret file in the execution service only.
# Never use the campaign owner's key, commit secrets, or paste keys into chat.
KEEPER_KEY_FILE=
# Optional hosting bootstrap: creates/reuses a service key on the persistent disk.
# Does not fund it or enable transaction execution.
INIT_KEEPER_ON_START=false
RUN_WORKER=false
